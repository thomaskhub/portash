[Unit]
Description=portash gateway (SSH over TLS on :443)
After=network-online.target
Wants=network-online.target

[Service]
# Per-VM mode: only this VM's own sshd on 127.0.0.1:22, daily TOTP unlock.
# In front of a Vabbit VPN instead: --network <NETWORK_CIDR> (e.g. 100.92.0.0/16).
ExecStart=/usr/local/bin/portash gateway --network 127.0.0.1/32 --ports 22 --listen :443 --dir /var/lib/portash --require-unlock
Restart=on-failure
# Runs as root so `sudo portash token add` files are readable, but with every
# capability except binding :443 removed.
StateDirectory=portash
StateDirectoryMode=0700
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/portash
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
MemoryMax=128M

[Install]
WantedBy=multi-user.target
